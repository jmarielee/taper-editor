{
  "space": {
    "xs": {
      "$type": "number",
      "$value": 4,
      "$description": "Tightest gap, such as between a banner headline and its message.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:731",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-xs)"
        }
      }
    },
    "sm": {
      "$type": "number",
      "$value": 8,
      "$description": "Gap between closely related items, such as a part label and its text.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:735",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-sm)"
        }
      }
    },
    "md": {
      "$type": "number",
      "$value": 12,
      "$description": "Gap between parts inside a component, such as a banner icon and its headline.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:738",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-md)"
        }
      }
    },
    "lg": {
      "$type": "number",
      "$value": 16,
      "$description": "Padding inside banners and cards.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:741",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-lg)"
        }
      }
    },
    "xl": {
      "$type": "number",
      "$value": 24,
      "$description": "Padding inside the race-week box on desktop, and the gap under the banner in a one-finding report.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:744",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-xl)"
        }
      }
    },
    "2xl": {
      "$type": "number",
      "$value": 32,
      "$description": "Space above each part label, and between the parts inside the race-week box.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:747",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-2xl)"
        }
      }
    },
    "3xl": {
      "$type": "number",
      "$value": 48,
      "$description": "Gap between major sections of the report.",
      "$extensions": {
        "com.figma.variableId": "VariableID:49:62",
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-3xl)"
        }
      }
    }
  },
  "radius": {
    "xs": {
      "$type": "number",
      "$value": 4,
      "$description": "Corners on the smallest marks, such as the tops of chart bars.",
      "$extensions": {
        "com.figma.variableId": "VariableID:52:63",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--radius-xs)"
        }
      }
    },
    "sm": {
      "$type": "number",
      "$value": 8,
      "$description": "Corners on small elements, such as tags and buttons.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:750",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--radius-sm)"
        }
      }
    },
    "md": {
      "$type": "number",
      "$value": 12,
      "$description": "Corners on banners and cards.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1:754",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--radius-md)"
        }
      }
    }
  },
  "$extensions": {
    "com.figma.modeName": "Mode 1"
  }
}